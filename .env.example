# PostgreSQL 16 (internal Docker network)
POSTGRES_USER=sro_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sro_rankings

# Async SQLAlchemy connection string (used by scraper-worker and Alembic)
DATABASE_URL=postgresql+asyncpg://sro_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/sro_rankings

# Prefect 3 API endpoint (use http://prefect-server:4200/api in Docker; http://localhost:4200/api on host)
PREFECT_API_URL=http://prefect-server:4200/api

# Application logging & resilience
LOG_LEVEL=INFO
QUARANTINE_DIR=./quarantine
QUARANTINE_RETENTION_DAYS=30
CIRCUIT_BREAKER_COOLDOWN_HOURS=6
MAX_PAGES_PER_CATEGORY=400

# Optional Cloudflare clearance cookie for Electus Online (leave empty unless needed)
ELECTUS_CF_CLEARANCE=

# RSilkroad pagination, inter-batch throttling (seconds), and optional Cloudflare clearance cookie
RSILKROAD_PAGE_SIZE=100
RSILKROAD_INTER_BATCH_DELAY_MIN=0.35
RSILKROAD_INTER_BATCH_DELAY_MAX=0.75
RSILKROAD_CF_CLEARANCE=

# Optional Discord webhooks (leave empty to disable notifications silently)
# DISCORD_OPS_WEBHOOK_URL: critical failure alerts (SCHEMA_DRIFT, LOW_COUNT_QUARANTINE, BLOCKED_CHALLENGE, HTTP_ERROR)
DISCORD_OPS_WEBHOOK_URL=
# DISCORD_COMMUNITY_WEBHOOK_URL: automatic post-Fortress War summary (fortresses + Top 5 guilds)
DISCORD_COMMUNITY_WEBHOOK_URL=

# Read-only Analytical Dashboard (Streamlit)
# Password used by scripts/provision_readonly_role.sh to create/update the `sro_readonly` role
DASHBOARD_DB_PASSWORD=CHANGE_ME_READONLY_PASSWORD
# Sync psycopg connection string for `sro_readonly` (URL-encode special characters such as @, #, :, / in the password)
DASHBOARD_DATABASE_URL=postgresql+psycopg://sro_readonly:CHANGE_ME_READONLY_PASSWORD@postgres:5432/sro_rankings
# Streamlit @st.cache_data TTL in seconds (min: 30, max: 3600)
DASHBOARD_CACHE_TTL_SECONDS=600
